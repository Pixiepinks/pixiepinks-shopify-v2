<nav class="pp-navigation" aria-label="{{ 'pp_v2.navigation' | t }}">
  <div class="pp-navigation__inner">
  <details class="pp-navigation__dropdown pp-all-categories">
    <summary aria-expanded="false">{% render 'icon-hamburger' %} {{ 'pp_v2.all_categories' | t }}{% render 'icon-caret' %}</summary>
    <div class="pp-navigation__panel">{% render 'pp-menu-tree' %}</div>
  </details>
  <ul class="pp-navigation__list" role="list">
    {% for link in section.settings.menu.links %}
      <li data-pp-nav-item>
        {% if link.links == blank %}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {% else %}
          <details class="pp-navigation__dropdown">
            <summary aria-expanded="false">{{ link.title | escape }}{% render 'icon-caret' %}</summary>
            <ul class="pp-navigation__panel" role="list">
              <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ 'pp_v2.browse' | t }} {{ link.title | escape }}</a></li>
              {% for childlink in link.links %}
                <li>
                  {% if childlink.links == blank %}
                    <a href="{{ childlink.url }}"{% if childlink.current %} aria-current="page"{% endif %}>{{ childlink.title | escape }}</a>
                  {% else %}
                    <details>
                      <summary aria-expanded="false">{{ childlink.title | escape }}{% render 'icon-caret' %}</summary>
                      <ul role="list">
                        <li><a href="{{ childlink.url }}"{% if childlink.current %} aria-current="page"{% endif %}>{{ 'pp_v2.browse' | t }} {{ childlink.title | escape }}</a></li>
                        {% for grandchildlink in childlink.links %}
                          <li><a href="{{ grandchildlink.url }}"{% if grandchildlink.current %} aria-current="page"{% endif %}>{{ grandchildlink.title | escape }}</a></li>
                        {% endfor %}
                      </ul>
                    </details>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </details>
        {% endif %}
      </li>
    {% endfor %}
    <li class="pp-nav-more" hidden>
      <details class="pp-navigation__dropdown"><summary aria-expanded="false">{{ 'pp_v2.more' | t }}{% render 'icon-caret' %}</summary><ul class="pp-navigation__panel pp-nav-more__panel" role="list"></ul></details>
    </li>
  </ul>
  {% render 'pp-offer' %}
  </div>
</nav>
