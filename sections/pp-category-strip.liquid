{{ 'pp-homepage.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} { --pp-home-top: {{ section.settings.padding_top }}px; --pp-home-bottom: {{ section.settings.padding_bottom }}px; }
{%- endstyle -%}
{% if section.settings.enabled %}
<div class="pp-home pp-home-categories">
  {% if section.settings.heading != blank %}<h2 class="pp-home-heading">{{ section.settings.heading | escape }}</h2>{% endif %}
  <ul class="pp-category-strip" role="list" {% if section.settings.heading != blank %}aria-label="{{ section.settings.heading | escape }}"{% else %}aria-label="{{ 'pp_v2.all_categories' | t }}"{% endif %} tabindex="0">
    {% for block in section.blocks %}
      {% liquid
        assign category = block.settings.collection
        assign destination = block.settings.link | default: category.url
        assign label = block.settings.label | default: category.title
        assign image = block.settings.image | default: category.featured_image
        if image == blank
          assign image = category.products.first.featured_image
        endif
      %}
      {% if destination != blank and label != blank %}
        <li class="pp-category" {{ block.shopify_attributes }}>
          <a href="{{ destination }}" class="pp-category__link">
            <span class="pp-category__image" style="--pp-category-accent: {{ block.settings.accent }};">
              {% if image != blank %}
                {{ image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '80, 120, 160, 240', sizes: '(max-width: 749px) 76px, 96px', alt: '' }}
              {% else %}
                {% render 'pp-icon', icon: 'gift' %}
              {% endif %}
            </span>
            <span class="pp-category__label">{{ label | escape }}</span>
          </a>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</div>
{% endif %}

{% schema %}
{
  "name": "PixiePinks categories",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show section",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Used for the image, label and destination when no override is selected."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label override"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Destination override"
        },
        {
          "type": "color",
          "id": "accent",
          "label": "Pastel background",
          "default": "#EAF6FF"
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "PixiePinks categories"
    }
  ]
}
{% endschema %}
