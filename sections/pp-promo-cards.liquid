{{ 'pp-homepage.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} { --pp-home-top: {{ section.settings.padding_top }}px; --pp-home-bottom: {{ section.settings.padding_bottom }}px; }
{%- endstyle -%}
{% if section.settings.enabled %}
<div class="pp-home pp-home-promotions">
  {% if section.settings.heading != blank %}<h2 class="pp-home-heading">{{ section.settings.heading | escape }}</h2>{% endif %}
  <div class="pp-promo-grid">
    {% for block in section.blocks %}
      {% liquid
        assign collection = block.settings.collection
        assign destination = block.settings.link | default: collection.url
        assign image = block.settings.image | default: collection.featured_image
        if image == blank
          assign image = collection.products.first.featured_image
        endif
        assign mobile_image = block.settings.mobile_image | default: image
        assign image = image | default: mobile_image
        assign promotion_name = block.settings.heading | default: collection.title | default: image.alt
        assign image_alt = block.settings.image_alt | default: image.alt | default: promotion_name | default: 'Promotional banner'
        assign button_label = block.settings.button_label | default: 'Shop Now'
        assign mobile_ratio = mobile_image.aspect_ratio | default: image.aspect_ratio | default: 3.8
      %}
      {% if image != blank %}
        <article
          class="pp-promo"
          style="--pp-promo-accent: {{ block.settings.accent }}; --pp-promo-mobile-ratio: {{ mobile_ratio }}; --pp-promo-offset-x: {{ block.settings.button_offset_x | default: 16 }}px; --pp-promo-offset-y: {{ block.settings.button_offset_y | default: 16 }}px;"
          {{ block.shopify_attributes }}
        >
          <picture class="pp-promo__image">
            {% if block.settings.mobile_image != blank %}
              <source
                media="(max-width: 749px)"
                srcset="{{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 550 }} 550w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w"
                sizes="calc(100vw - 32px)"
                width="{{ mobile_image.width }}"
                height="{{ mobile_image.height }}"
              >
            {% endif %}
            {{ image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '240, 400, 600, 800, 1200, 1600', sizes: '(min-width: 1600px) 501px, (min-width: 990px) calc((100vw - 96px) / 3), (min-width: 750px) calc((100vw - 64px) / 2), calc(100vw - 32px)', alt: image_alt }}
          </picture>
          {% if destination != blank and block.settings.show_button != false %}
            <div class="pp-promo__actions pp-promo__actions--{{ block.settings.button_horizontal | default: 'left' }} pp-promo__actions--{{ block.settings.button_vertical | default: 'bottom' }}">
              <a class="pp-button pp-promo__button" href="{{ destination }}" aria-label="{{ button_label | escape }}{% if promotion_name != blank %}: {{ promotion_name | escape }}{% endif %}">{{ button_label | escape }}<span aria-hidden="true">&rarr;</span></a>
            </div>
          {% endif %}
        </article>
      {% endif %}
    {% endfor %}
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "PixiePinks promotions",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading"
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show section",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "promotion",
      "name": "Promotional card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Optional collection",
          "info": "Used for the destination and fallback image when no banner override is selected."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop banner image",
          "info": "Recommended: 1520 × 400 px (3.8:1), with wording and artwork included. Other proportions remain uncropped and may show the background."
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile banner image",
          "info": "Optional. Uses its own proportions; falls back to the desktop artwork."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Banner description",
          "info": "Describe the banner and any important wording in the artwork for screen readers."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Accessible promotion name",
          "info": "Existing headings are retained as accessible labels only; no heading is printed over the banner."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Legacy text (not displayed)",
          "info": "Retained for existing settings. Include promotional wording in the uploaded artwork."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Destination override"
        },
        {
          "type": "color",
          "id": "accent",
          "label": "Background",
          "default": "#FFF0F4"
        },
        {
          "type": "checkbox",
          "id": "show_button",
          "label": "Show Shop Now button",
          "default": true
        },
        {
          "type": "select",
          "id": "button_horizontal",
          "label": "Button horizontal position",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "button_vertical",
          "label": "Button vertical position",
          "options": [
            {
              "value": "top",
              "label": "Top"
            },
            {
              "value": "middle",
              "label": "Middle"
            },
            {
              "value": "bottom",
              "label": "Bottom"
            }
          ],
          "default": "bottom"
        },
        {
          "type": "range",
          "id": "button_offset_x",
          "label": "Button horizontal inset",
          "min": 0,
          "max": 48,
          "step": 4,
          "unit": "px",
          "default": 16
        },
        {
          "type": "range",
          "id": "button_offset_y",
          "label": "Button vertical inset",
          "min": 0,
          "max": 48,
          "step": 4,
          "unit": "px",
          "default": 16
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "PixiePinks promotions"
    }
  ]
}
{% endschema %}
