{{ 'pp-homepage.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} { --pp-home-top: {{ section.settings.padding_top }}px; --pp-home-bottom: {{ section.settings.padding_bottom }}px; }
{%- endstyle -%}
{% if section.settings.enabled %}
<div class="pp-home pp-home-promotions">
  {% if section.settings.heading != blank %}<h2 class="pp-home-heading">{{ section.settings.heading | escape }}</h2>{% endif %}
  <div class="pp-promo-grid">
    {% for block in section.blocks %}
      {% liquid
        assign collection = block.settings.collection
        assign destination = block.settings.link | default: collection.url
        assign heading = block.settings.heading | default: collection.title
        assign image = block.settings.image | default: collection.featured_image
        if image == blank
          assign image = collection.products.first.featured_image
        endif
        assign button_label = block.settings.button_label
        if button_label == blank
          assign button_label = 'sections.collection_list.view_all' | t
        endif
      %}
      {% if heading != blank or image != blank %}
        <article class="pp-promo" style="--pp-promo-accent: {{ block.settings.accent }};" {{ block.shopify_attributes }}>
          <div class="pp-promo__copy">
            {% if heading != blank %}<h3>{{ heading | escape }}</h3>{% endif %}
            {% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}
            {% if destination != blank %}<a class="pp-button pp-promo__button" href="{{ destination }}" aria-label="{{ button_label | escape }}{% if heading != blank %}: {{ heading | escape }}{% endif %}">{{ button_label | escape }}<span aria-hidden="true">&rarr;</span></a>{% endif %}
          </div>
          {% if image != blank %}<div class="pp-promo__image">{{ image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '240, 400, 600, 800', sizes: '(max-width: 749px) 55vw, (max-width: 989px) 30vw, 20vw', alt: '' }}</div>{% endif %}
        </article>
      {% endif %}
    {% endfor %}
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "PixiePinks promotions",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading"
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show section",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "promotion",
      "name": "Promotional card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Optional collection",
          "info": "Use an existing collection as the default heading, image and destination."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading override"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Destination override"
        },
        {
          "type": "color",
          "id": "accent",
          "label": "Background",
          "default": "#FFF0F4"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "PixiePinks promotions"
    }
  ]
}
{% endschema %}
