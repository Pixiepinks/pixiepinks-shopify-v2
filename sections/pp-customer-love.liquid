{{ 'pp-customer-love.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pp-customer-love.js' | asset_url }}" defer="defer"></script>
{% liquid
  assign count = 0
  for block in section.blocks
    if block.settings.image != blank
      assign count = count | plus: 1
    endif
  endfor
%}
{% if count > 0 or request.design_mode %}
<div class="pp-love" style="--pp-love-padding: {{ section.settings.padding }}px; --pp-love-width: {{ section.settings.card_width }}px; --pp-love-radius: {{ section.settings.radius }}px; --pp-love-overlay: {{ section.settings.overlay | divided_by: 100.0 }};">
  {% if section.settings.background != blank %}
    <picture class="pp-love__background" aria-hidden="true">
      {% if section.settings.mobile_background != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.mobile_background | image_url: width: 1000 }}">{% endif %}
      {{ section.settings.background | image_url: width: 2400 | image_tag: widths: '750, 1200, 1800, 2400', sizes: '100vw', loading: 'lazy', alt: '' }}
    </picture>
  {% endif %}
  <div class="pp-love__content">
    {% if section.settings.heading != blank %}<h2 class="pp-love__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.subtitle != blank %}<p class="pp-love__subtitle">{{ section.settings.subtitle | escape }}</p>{% endif %}
    {% if count > 0 %}
    <pp-review-carousel data-speed="{{ section.settings.speed }}" data-auto="{{ section.settings.auto }}">
      <ul class="pp-love__track" role="list" tabindex="0" aria-label="{{ section.settings.heading | default: 'Customer reviews' | escape }}">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
        <li class="pp-love__card" {{ block.shopify_attributes }}>
          {% assign image_alt = block.settings.alt | default: 'Customer appreciation screenshot' %}
          {{ block.settings.image | image_url: width: 1440 | image_tag: widths: '320, 480, 720, 960, 1440', sizes: '(max-width: 749px) 85vw, 480px', loading: 'lazy', alt: image_alt }}
          {% if block.settings.name != blank or block.settings.product != blank or block.settings.date != blank %}
          <div class="pp-love__details">
            {% if block.settings.name != blank %}<strong>{{ block.settings.name | escape }}</strong>{% endif %}
            {% if block.settings.product != blank %}<span>{{ block.settings.product | escape }}</span>{% endif %}
            {% if block.settings.date != blank %}<span>{{ block.settings.date | escape }}</span>{% endif %}
          </div>
          {% endif %}
        </li>
        {% endif %}
      {% endfor %}
      </ul>
    </pp-review-carousel>
    {% elsif request.design_mode %}<p class="pp-love__empty">Add a Customer Review block and upload a screenshot. Redact private details before uploading.</p>{% endif %}
  </div>
</div>
{% endif %}
{% schema %}
{
  "name": "PixiePinks Customer Love",
  "tag": "section",
  "class": "section",
  "max_blocks": 50,
  "settings": [
    {
      "type": "image_picker",
      "id": "background",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_background",
      "label": "Mobile background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by Our Happy Customers"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Real Messages \u2022 Real Customers \u2022 Real Happiness"
    },
    {
      "type": "checkbox",
      "id": "auto",
      "label": "Enable automatic scrolling",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scrolling speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "default": 25
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Background overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Section vertical padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Review card width",
      "min": 240,
      "max": 480,
      "step": 10,
      "default": 360,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Review card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 20,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "WhatsApp screenshot image",
          "info": "Upload only screenshots you have permission to share. Redact private information before uploading."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer display name (optional)"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product or category (optional)"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Review date (optional)"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image description (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PixiePinks Customer Love"
    }
  ]
}
{% endschema %}
